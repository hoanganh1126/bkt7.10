#include <stdio.h>
#include <string.h>

typedef struct {
    int maKH;
    char tenKH[50];
    char soDienThoai[15];
    float tongTien;
} KhachHang;

void nhap(KhachHang a[], int n) {
    int i;

    for (i = 0; i < n; i++) {
        printf("\nNhap khach hang thu %d:\n", i + 1);

        printf("Ma khach hang: ");
        scanf("%d", &a[i].maKH);

        getchar();

        printf("Ten khach hang: ");
        fgets(a[i].tenKH, sizeof(a[i].tenKH), stdin);
        a[i].tenKH[strcspn(a[i].tenKH, "\n")] = '\0';

        printf("So dien thoai: ");
        fgets(a[i].soDienThoai, sizeof(a[i].soDienThoai), stdin);
        a[i].soDienThoai[strcspn(a[i].soDienThoai, "\n")] = '\0';

        printf("Tong tien thanh toan: ");
        scanf("%f", &a[i].tongTien);
    }
}

void xuat(KhachHang a[], int n) {
    int i;

    printf("\n%-10s %-25s %-15s %-15s\n",
           "Ma KH", "Ten KH", "So dien thoai", "Tong tien");

    for (i = 0; i < n; i++) {
        printf("%-10d %-25s %-15s %-15.2f\n",
               a[i].maKH,
               a[i].tenKH,
               a[i].soDienThoai,
               a[i].tongTien);
    }
}

void insertionSort(KhachHang a[], int n) {
    int i, j;
    KhachHang key;

    for (i = 1; i < n; i++) {
        key = a[i];
        j = i - 1;

        while (j >= 0 && a[j].tongTien > key.tongTien) {
            a[j + 1] = a[j];
            j--;
        }

        a[j + 1] = key;
    }
}

void timKiemNhiPhan(KhachHang a[], int n, float x) {
    int left = 0;
    int right = n - 1;
    int found = 0;

    while (left <= right) {
        int mid = (left + right) / 2;

        if (a[mid].tongTien == x) {
            int i;

            printf("\nCac khach hang co tong tien bang %.2f:\n", x);

            i = mid;
            while (i >= 0 && a[i].tongTien == x) {
                i--;
            }

            i++;

            while (i < n && a[i].tongTien == x) {
                printf("Ma KH: %d | Ten: %s | SDT: %s | Tong tien: %.2f\n",
                       a[i].maKH,
                       a[i].tenKH,
                       a[i].soDienThoai,
                       a[i].tongTien);
                i++;
            }

            found = 1;
            break;
        }
        else if (a[mid].tongTien < x) {
            left = mid + 1;
        }
        else {
            right = mid - 1;
        }
    }

    if (found == 0) {
        printf("\nKhong tim thay khach hang co tong tien bang %.2f\n", x);
    }
}

int main() {
    KhachHang a[100];
    int n;
    float x;

    printf("Nhap so luong khach hang: ");
    scanf("%d", &n);

    nhap(a, n);

    printf("\n===== DANH SACH KHACH HANG VUA NHAP =====\n");
    xuat(a, n);

    insertionSort(a, n);

    printf("\n===== DANH SACH SAU KHI SAP XEP =====\n");
    xuat(a, n);

    printf("\nNhap tong tien can tim X: ");
    scanf("%f", &x);

    timKiemNhiPhan(a, n, x);

    return 0;
}
